---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Calendar | Student Commodity Insights" description="Daily WTI oil price calendar" />
    <style>
      .page-wrapper {
        max-width: 900px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
      }
      .page-header {
        border-bottom: 2px solid var(--navy);
        padding-bottom: 1.5rem;
        margin-bottom: 2.5rem;
      }
      .page-header h1 { font-size: 2rem; color: var(--navy); }
      .page-header p { color: var(--text-muted); font-size: 0.9rem; margin-top: 0.3rem; }
      .legend {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
      }
      .legend-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        color: var(--text-muted);
      }
      .legend-dot {
        width: 14px;
        height: 14px;
        border-radius: 3px;
      }
      .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
      }
      .day-label {
        text-align: center;
        font-size: 0.75rem;
        color: var(--text-muted);
        padding: 0.5rem 0;
        font-weight: 600;
      }
      .day-cell {
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.15s;
        min-height: 90px;
        padding: 0.5rem;
      }
      .day-cell:hover { transform: scale(1.05); }
      .day-cell.empty { background: transparent; cursor: default; pointer-events: none; }
      .day-cell.no-data { background: rgba(255,255,255,0.05); }
      .day-number {
        font-size: 1rem;
        font-weight: 700;
        color: white;
        display: block;
      }
      .day-cell.no-data .day-number { opacity: 0.3; }
      .modal-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0,0,0,0.7);
        z-index: 100;
        align-items: center;
        justify-content: center;
      }
      .modal-overlay.active { display: flex; }
      .modal {
        background: #0f1f3d;
        border-radius: 16px;
        padding: 2rem;
        max-width: 500px;
        width: 90%;
        color: white;
        max-height: 80vh;
        overflow-y: auto;
      }
      .modal h2 { font-size: 1.4rem; margin-bottom: 1rem; }
      .price-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(255,255,255,0.05);
        border-radius: 8px;
        padding: 0.8rem 1rem;
        margin-bottom: 0.5rem;
      }
      .price-label { font-size: 0.85rem; opacity: 0.6; }
      .price-value { font-size: 1.3rem; font-weight: 700; }
      .price-change { font-size: 0.85rem; font-weight: 600; }
      .price-change.up { color: #4ade80; }
      .price-change.down { color: #f87171; }
      .modal h3 { font-size: 0.85rem; opacity: 0.6; margin-bottom: 0.5rem; margin-top: 1.5rem; letter-spacing: 1px; }
    .modal .dot-jot {
  background: rgba(255,255,255,0.05);
  border-radius: 8px;
  padding: 0.8rem;
  margin-bottom: 0.5rem;
  max-height: 150px;
  overflow-y: auto;
}
      .modal .summary {
        background: rgba(255,255,255,0.05);
        border-radius: 8px;
        padding: 0.8rem;
        font-size: 0.9rem;
        line-height: 1.6;
      }
      .modal-close {
        float: right;
        background: none;
        border: none;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        opacity: 0.7;
      }
      .status-text {
        text-align: center;
        color: var(--text-muted);
        padding: 1rem;
        font-style: italic;
        font-size: 0.85rem;
      }
    </style>
  </head>
  <body class="dark">
    <Header />
    <main>
      <div class="page-wrapper">
        <div class="page-header">
          <h1>WTI Price Calendar</h1>
          <p>Daily closing prices — click any day for details</p>
        </div>

        <div class="legend">
          <div class="legend-item"><div class="legend-dot" style="background:#16a34a"></div> Big gain (+5%+)</div>
          <div class="legend-item"><div class="legend-dot" style="background:#86efac"></div> Small gain</div>
          <div class="legend-item"><div class="legend-dot" style="background:#6b7280"></div> Flat</div>
          <div class="legend-item"><div class="legend-dot" style="background:#fca5a5"></div> Small drop</div>
          <div class="legend-item"><div class="legend-dot" style="background:#dc2626"></div> Big drop (-5%+)</div>
        </div>

        <div class="calendar-grid" id="calendar-grid">
          <div class="day-label">Sun</div>
          <div class="day-label">Mon</div>
          <div class="day-label">Tue</div>
          <div class="day-label">Wed</div>
          <div class="day-label">Thu</div>
          <div class="day-label">Fri</div>
          <div class="day-label">Sat</div>
        </div>

        <p class="status-text" id="status-text">Loading price data...</p>
      </div>
    </main>

    <div class="modal-overlay" id="modal-overlay">
      <div class="modal">
        <button class="modal-close" id="modal-close">×</button>
        <h2 id="modal-date"></h2>
        <div id="modal-wti" class="price-row">
          <span class="price-label">WTI Crude</span>
          <span class="price-value" id="modal-wti-price"></span>
          <span class="price-change" id="modal-wti-change"></span>
        </div>
        <div id="modal-brent" class="price-row">
          <span class="price-label">Brent Crude</span>
          <span class="price-value" id="modal-brent-price"></span>
          <span class="price-change" id="modal-brent-change"></span>
        </div>
        <h3>DOT JOTS</h3>
        <div id="modal-dotjots"><div class="dot-jot">Dot jots coming soon.</div></div>
      </div>
    </div>

    <script>
      async function fetchPriceData() {
        const res = await fetch('https://wti-price-cache.kevinluo6136.workers.dev');
        const data = await res.json();
        return data;
      }

      function getColorClass(pct) {
        if (pct >= 5) return 'big-up';
        if (pct > 0.5) return 'small-up';
        if (pct <= -5) return 'big-down';
        if (pct < -0.5) return 'small-down';
        return 'flat';
      }

      function buildCalendar(priceData) {
        const wti = priceData.wti || {};
        const grid = document.getElementById('calendar-grid');
        const statusEl = document.getElementById('status-text');
        statusEl.style.display = 'none';

        const now = new Date();
        const year = now.getFullYear();
        const month = now.getMonth();

        const firstDay = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const sortedDates = Object.keys(wti).sort();

        for (let i = 0; i < firstDay; i++) {
          const empty = document.createElement('div');
          empty.className = 'day-cell empty';
          grid.appendChild(empty);
        }

        for (let d = 1; d <= daysInMonth; d++) {
          const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
          const cell = document.createElement('div');
          const close = wti[dateStr];

          if (close !== undefined) {
            const idx = sortedDates.indexOf(dateStr);
            const prevDate = idx > 0 ? sortedDates[idx - 1] : null;
            const prevClose = prevDate ? wti[prevDate] : null;
            const pct = prevClose ? ((close - prevClose) / prevClose) * 100 : 0;
            const colorClass = prevClose ? getColorClass(pct) : 'flat';

            cell.className = `day-cell ${colorClass}`;
            cell.innerHTML = `<span class="day-number">${d}</span>`;
            cell.addEventListener('click', () => openModal(dateStr, priceData, pct));
          } else {
            const now = new Date();
const localDate = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
const isToday = dateStr === localDate;
  cell.className = `day-cell no-data${isToday ? ' today-clickable' : ''}`;
  cell.innerHTML = `<span class="day-number">${d}</span>`;
  if (isToday) {
    cell.style.cursor = 'pointer';
    cell.style.pointerEvents = 'auto';
    cell.addEventListener('click', () => openModal(dateStr, priceData, 0));
  }
          }

          grid.appendChild(cell);
        }

        const dataCount = Object.keys(wti).filter(d => d.startsWith(`${year}-${String(month + 1).padStart(2, '0')}`)).length;
        if (dataCount === 0) {
          statusEl.style.display = 'block';
          statusEl.textContent = 'Price data not yet available — check back soon.';
        }
      }

      function getPct(data, date, sortedDates) {
        const close = data[date];
        if (!close) return null;
        const idx = sortedDates.indexOf(date);
        const prevDate = idx > 0 ? sortedDates[idx - 1] : null;
        const prevClose = prevDate ? data[prevDate] : null;
        return prevClose ? ((close - prevClose) / prevClose) * 100 : 0;
      }

      async function openModal(date, priceData, wtiPct) {
  const wti = priceData.wti || {};
  const brent = priceData.brent || {};
  const wtiSorted = Object.keys(wti).sort();
  const brentSorted = Object.keys(brent).sort();

  document.getElementById('modal-date').textContent = new Date(date + 'T12:00:00').toLocaleDateString('en-US', {
    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
  });

const now = new Date();
const localDate = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
const isPastDay = date < localDate;

const wtiPrice = wti[date];
if (wtiPrice && isPastDay) {
  document.getElementById('modal-wti-price').textContent = `$${wtiPrice.toFixed(2)}`;
  const up = wtiPct >= 0;
  const changeEl = document.getElementById('modal-wti-change');
  changeEl.textContent = `${up ? '▲' : '▼'} ${Math.abs(wtiPct).toFixed(2)}%`;
  changeEl.className = `price-change ${up ? 'up' : 'down'}`;
} else if (!isPastDay) {
  document.getElementById('modal-wti-price').textContent = 'Live';
  document.getElementById('modal-wti-change').textContent = '';
}

const brentPrice = brent[date];
const brentPct = getPct(brent, date, brentSorted);
if (brentPrice && isPastDay) {
  document.getElementById('modal-brent-price').textContent = `$${brentPrice.toFixed(2)}`;
  const up = brentPct >= 0;
  const changeEl = document.getElementById('modal-brent-change');
  changeEl.textContent = `${up ? '▲' : '▼'} ${Math.abs(brentPct).toFixed(2)}%`;
  changeEl.className = `price-change ${up ? 'up' : 'down'}`;
} else if (!isPastDay) {
  document.getElementById('modal-brent-price').textContent = 'Live';
  document.getElementById('modal-brent-change').textContent = '';
}

  // Fetch dot jots
  const dotjotsEl = document.getElementById('modal-dotjots');
  dotjotsEl.innerHTML = '<div class="dot-jot">Loading...</div>';


  try {
    const res = await fetch(`https://dotjots-api.kevinluo6136.workers.dev/?date=${date}`);
    const jots = await res.json();

    if (jots.length === 0) {
      dotjotsEl.innerHTML = '<div class="dot-jot" style="opacity:0.4">No dot jots for this day.</div>';

    } else {
dotjotsEl.innerHTML = jots.map(j => `
  <div class="dot-jot">
    <div style="font-size:0.8rem; opacity:0.5; margin-bottom:4px;">${j.time ? new Date(j.time).toLocaleTimeString('en-US', {hour:'2-digit', minute:'2-digit'}) : ''}</div>
    <div style="font-size:0.85rem; font-weight:400; margin-bottom:6px;">${j.headline}</div>
    <div style="font-size:0.78rem; opacity:0.6; line-height:1.6; white-space:pre-wrap;">${j.summary || ''}</div>
  </div>
`).join('');
      // Use the last jot's summary as the daily summary
      
    }
  } catch (e) {
    dotjotsEl.innerHTML = '<div class="dot-jot" style="opacity:0.4">Could not load dot jots.</div>';
  }

  document.getElementById('modal-overlay').classList.add('active');
}
      document.getElementById('modal-close').addEventListener('click', () => {
        document.getElementById('modal-overlay').classList.remove('active');
      });

      document.getElementById('modal-overlay').addEventListener('click', (e) => {
        if (e.target === document.getElementById('modal-overlay')) {
          document.getElementById('modal-overlay').classList.remove('active');
        }
      });

      fetchPriceData().then(buildCalendar).catch(err => {
        console.error(err);
        document.getElementById('status-text').textContent = 'Could not load price data.';
      });
    </script>
  </body>
</html>
