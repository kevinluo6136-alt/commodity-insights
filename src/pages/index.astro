---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style is:global>
      * {
        font-family: 'Times New Roman', Times, serif;
      }
      .page-wrapper {
        max-width: 1100px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
      }
      .page-header {
        border-bottom: 2px solid var(--navy);
        padding-bottom: 1.5rem;
        margin-bottom: 2.5rem;
      }
      .page-header h1 { font-size: 2rem; color: var(--navy); }
      .page-header p { color: rgba(255,255,255,0.4); font-size: 0.9rem; margin-top: 0.3rem; }
      .day-block { margin-bottom: 2.5rem; }
      .day-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0.5rem 0;
        border-top: 1px solid rgba(255,255,255,0.2);
        border-bottom: 1px solid rgba(255,255,255,0.2);
        margin-bottom: 1rem;
      }
      .day-date { font-size: 13px; font-weight: 600; color: #16a34a; letter-spacing: 0.5px; }
      .day-badge {
        font-size: 11px;
        background: rgba(255,255,255,0.05);
        color: rgba(255,255,255,0.4);
        border-radius: 6px;
        padding: 2px 8px;
        border: 0.5px solid rgba(255,255,255,0.1);
      }
      .day-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
      }
      .card {
        background: rgba(255,255,255,0.03);
        border: 0.5px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 1rem 1.25rem;
      }
      .card-label {
        font-size: 11px;
        color: rgba(255,255,255,0.3);
        letter-spacing: 1px;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
      }
      .points-list { list-style: none; padding: 0; margin: 0; }
      .points-list li {
        font-size: 13px;
        color: rgba(255,255,255,0.85);
        padding: 5px 0;
        border-bottom: 0.5px solid rgba(255,255,255,0.06);
        display: flex;
        gap: 8px;
        line-height: 1.4;
      }
      .points-list li:last-child { border-bottom: none; }
      .point-num { color: #16a34a; font-weight: 600; min-width: 14px; }
      .summary-text { font-size: 13px; color: rgba(255,255,255,0.6); line-height: 1.6; margin: 0 0 1rem 0; }
      .outlook-row { display: flex; flex-direction: column; gap: 8px; }
      .outlook-item { display: flex; flex-direction: column; gap: 2px; }
      .outlook-tag { font-size: 11px; font-weight: 600; }
      .outlook-tag.bull { color: #16a34a; }
      .outlook-tag.bear { color: #dc2626; }
      .outlook-tag.base { color: rgba(255,255,255,0.4); }
      .outlook-val { font-size: 12px; color: rgba(255,255,255,0.5); line-height: 1.4; }
      .divider { border: none; border-top: 0.5px solid rgba(255,255,255,0.08); margin: 0.75rem 0; }
      .ai-tag { font-size: 11px; font-weight: 600; color: #7c3aed; }
      .watch-tag { font-size: 11px; font-weight: 600; color: #d97706; margin-bottom: 4px; display: block; }
      .watch-list { list-style: none; padding: 0; margin: 0; }
      .watch-list li { font-size: 12px; color: rgba(255,255,255,0.5); padding: 3px 0; display: flex; gap: 6px; line-height: 1.4; }
      .watch-dot { color: #d97706; }
      .dim { opacity: 0.3; }
      .loading-text { color: rgba(255,255,255,0.3); font-style: italic; font-size: 0.85rem; }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="page-wrapper">
        <div class="page-header">
          <h1>Daily Market Briefing</h1>
          <p>AI-curated oil market insights — updated every evening</p>
        </div>
        <div id="feed">
          <p class="loading-text">Loading briefings...</p>
        </div>
      </div>
    </main>
    <Footer />

    <script>
      async function fetchEOD(date) {
        const res = await fetch(`https://dotjots-api.kevinluo6136.workers.dev/eod?date=${date}`);
        const data = await res.json();
        return data;
      }

      function formatDate(dateStr) {
        return new Date(dateStr + 'T12:00:00').toLocaleDateString('en-US', {
          month: 'long', day: 'numeric', year: 'numeric'
        });
      }

      function isToday(dateStr) {
        return dateStr === new Date().toISOString().split('T')[0];
      }

      function renderDay(dateStr, data) {
        const today = isToday(dateStr);
        if (!data) {
          return `
            <div class="day-block">
              <div class="day-header">
                <span class="day-date">${formatDate(dateStr)}</span>
                ${today ? '<span class="day-badge">Today</span>' : ''}
              </div>
              <div class="day-grid">
                <div class="card"><div class="card-label">Key points</div><p class="loading-text">No data yet.</p></div>
                <div class="card"><div class="card-label">Daily summary</div><p class="loading-text">No data yet.</p></div>
                <div class="card"><div class="card-label">AI read</div><p class="loading-text">No data yet.</p></div>
              </div>
            </div>`;
        }

        const points = (data.points || []).map((p, i) =>
          `<li>${p}</li>`
        ).join('');

        const watch = (data.watch || []).map(w =>
          `<li><span class="watch-dot">›</span>${w}</li>`
        ).join('');

        return `
          <div class="day-block">
            <div class="day-header">
              <span class="day-date">${formatDate(dateStr)}</span>
              ${today ? '<span class="day-badge">Today</span>' : ''}
            </div>
            <div class="day-grid">
              <div class="card">
                <div class="card-label">Key points</div>
                <ul class="points-list">${points}</ul>
              </div>
              <div class="card">
                <div class="card-label">Daily summary</div>
                <p class="summary-text">${data.summary || ''}</p>
                <hr class="divider">
                <div class="outlook-row">
                  <div class="outlook-item">
                    <span class="outlook-tag bull">Bullish</span>
                    <span class="outlook-val">${data.bullish || ''}</span>
                  </div>
                  <div class="outlook-item">
                    <span class="outlook-tag base">Base case</span>
                    <span class="outlook-val">${data.base || ''}</span>
                  </div>
                  <div class="outlook-item">
                    <span class="outlook-tag bear">Bearish</span>
                    <span class="outlook-val">${data.bearish || ''}</span>
                  </div>
                </div>
              </div>
              <div class="card">
                <div class="card-label">AI read</div>
                <div class="outlook-item" style="margin-bottom: 10px;">
                  <span class="ai-tag">Interpretation</span>
                  <span class="outlook-val" style="margin-top: 2px;">${data.ai_read || ''}</span>
                </div>
                <hr class="divider">
                <span class="watch-tag">Things to watch</span>
                <ul class="watch-list">${watch}</ul>
              </div>
            </div>
          </div>`;
      }

      async function buildFeed() {
        const feed = document.getElementById('feed');
        const today = new Date();
        const dates = [];

        for (let i = 0; i < 60; i++) {
          const d = new Date(today);
          d.setDate(today.getDate() - i);
          dates.push(d.toISOString().split('T')[0]);
        }

        const results = await Promise.all(dates.map(fetchEOD));
        const hasAny = results.some(r => r !== null);

        if (!hasAny) {
          feed.innerHTML = '<p class="loading-text">No briefings yet — check back after market close.</p>';
          return;
        }

        feed.innerHTML = dates.map((date, i) => renderDay(date, results[i])).join('');
      }

      buildFeed();
    </script>
  </body>
</html>
